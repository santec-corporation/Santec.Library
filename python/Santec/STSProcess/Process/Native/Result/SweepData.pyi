from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.SOP import SOP

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SweepData(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SweepData: ...
  @classmethod
  def GetRootAsSweepData(cls, buf: bytes, offset: int) -> SweepData: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Power(self, i: int) -> typing.List[float]: ...
  def PowerAsNumpy(self) -> np.ndarray: ...
  def PowerLength(self) -> int: ...
  def PowerIsNone(self) -> bool: ...
  def PowerUnit(self) -> int: ...
  def PowerMonitor(self, i: int) -> typing.List[float]: ...
  def PowerMonitorAsNumpy(self) -> np.ndarray: ...
  def PowerMonitorLength(self) -> int: ...
  def PowerMonitorIsNone(self) -> bool: ...
  def PowerMonitorUnit(self) -> int: ...
  def Polarization(self) -> typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]: ...
def SweepDataStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SweepDataAddPower(builder: flatbuffers.Builder, power: uoffset) -> None: ...
def SweepDataStartPowerVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPowerVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SweepDataAddPowerUnit(builder: flatbuffers.Builder, powerUnit: int) -> None: ...
def SweepDataAddPowerMonitor(builder: flatbuffers.Builder, powerMonitor: uoffset) -> None: ...
def SweepDataStartPowerMonitorVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPowerMonitorVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SweepDataAddPowerMonitorUnit(builder: flatbuffers.Builder, powerMonitorUnit: int) -> None: ...
def SweepDataAddPolarization(builder: flatbuffers.Builder, polarization: typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]) -> None: ...
def SweepDataEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

