from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.ChannelKey import ChannelKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SweepKey(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SweepKey: ...
  @classmethod
  def GetRootAsSweepKey(cls, buf: bytes, offset: int) -> SweepKey: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ChannelKey(self) -> ChannelKey | None: ...
  def Cycle(self) -> int: ...
def SweepKeyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SweepKeyAddChannelKey(builder: flatbuffers.Builder, channelKey: uoffset) -> None: ...
def SweepKeyAddCycle(builder: flatbuffers.Builder, cycle: int) -> None: ...
def SweepKeyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

