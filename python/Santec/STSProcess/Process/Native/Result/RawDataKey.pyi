from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Parameters.PowerRange import PowerRange
from Santec.STSProcess.Process.Native.Result.SOP import SOP
from Santec.STSProcess.Process.Native.Result.SweepKey import SweepKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RawDataKey(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RawDataKey: ...
  @classmethod
  def GetRootAsRawDataKey(cls, buf: bytes, offset: int) -> RawDataKey: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def SweepKey(self) -> SweepKey | None: ...
  def Polarization(self) -> typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]: ...
  def PowerRange(self) -> PowerRange | None: ...
def RawDataKeyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RawDataKeyAddSweepKey(builder: flatbuffers.Builder, sweepKey: uoffset) -> None: ...
def RawDataKeyAddPolarization(builder: flatbuffers.Builder, polarization: typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]) -> None: ...
def RawDataKeyAddPowerRange(builder: flatbuffers.Builder, powerRange: uoffset) -> None: ...
def RawDataKeyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

