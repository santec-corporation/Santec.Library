from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.SweepData import SweepData
from Santec.STSProcess.Process.Native.Result.SweepKey import SweepKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ILReferenceResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ILReferenceResult: ...
  @classmethod
  def GetRootAsILReferenceResult(cls, buf: bytes, offset: int) -> ILReferenceResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Wavelength(self, i: int) -> typing.List[float]: ...
  def WavelengthAsNumpy(self) -> np.ndarray: ...
  def WavelengthLength(self) -> int: ...
  def WavelengthIsNone(self) -> bool: ...
  def WavelengthUnit(self) -> int: ...
  def SweepKey(self) -> SweepKey | None: ...
  def Data(self) -> SweepData | None: ...
def ILReferenceResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ILReferenceResultAddWavelength(builder: flatbuffers.Builder, wavelength: uoffset) -> None: ...
def ILReferenceResultStartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ILReferenceResultAddWavelengthUnit(builder: flatbuffers.Builder, wavelengthUnit: int) -> None: ...
def ILReferenceResultAddSweepKey(builder: flatbuffers.Builder, sweepKey: uoffset) -> None: ...
def ILReferenceResultAddData(builder: flatbuffers.Builder, data: uoffset) -> None: ...
def ILReferenceResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

