from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ModuleKey(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ModuleKey: ...
  @classmethod
  def GetRootAsModuleKey(cls, buf: bytes, offset: int) -> ModuleKey: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ModuleNumber(self) -> int: ...
  def ModuleType(self) -> str | None: ...
  def Identifier(self) -> str | None: ...
def ModuleKeyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ModuleKeyAddModuleNumber(builder: flatbuffers.Builder, moduleNumber: int) -> None: ...
def ModuleKeyAddModuleType(builder: flatbuffers.Builder, moduleType: uoffset) -> None: ...
def ModuleKeyAddIdentifier(builder: flatbuffers.Builder, identifier: uoffset) -> None: ...
def ModuleKeyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

