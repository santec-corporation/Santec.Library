from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.DataStatus import DataStatus
from Santec.STSProcess.Process.Native.Result.ProcessedDataKey import ProcessedDataKey
from Santec.STSProcess.Process.Native.Result.ReferenceConditions import ReferenceConditions
from Santec.STSProcess.Process.Native.Result.SweepInfo import SweepInfo

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ProcessedData(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ProcessedData: ...
  @classmethod
  def GetRootAsProcessedData(cls, buf: bytes, offset: int) -> ProcessedData: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Key(self) -> ProcessedDataKey | None: ...
  def SweepData(self) -> SweepInfo | None: ...
  def Wavelength(self, i: int) -> typing.List[float]: ...
  def WavelengthAsNumpy(self) -> np.ndarray: ...
  def WavelengthLength(self) -> int: ...
  def WavelengthIsNone(self) -> bool: ...
  def PowerData(self, i: int) -> typing.List[float]: ...
  def PowerDataAsNumpy(self) -> np.ndarray: ...
  def PowerDataLength(self) -> int: ...
  def PowerDataIsNone(self) -> bool: ...
  def PowerDataStatus(self) -> typing.Literal[DataStatus.NoData, DataStatus.Original, DataStatus.Processed]: ...
  def PowerMonitorData(self, i: int) -> typing.List[float]: ...
  def PowerMonitorDataAsNumpy(self) -> np.ndarray: ...
  def PowerMonitorDataLength(self) -> int: ...
  def PowerMonitorDataIsNone(self) -> bool: ...
  def PowerMonitorDataStatus(self) -> typing.Literal[DataStatus.NoData, DataStatus.Original, DataStatus.Processed]: ...
  def ReferenceConditions(self) -> ReferenceConditions | None: ...
def ProcessedDataStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ProcessedDataAddKey(builder: flatbuffers.Builder, key: uoffset) -> None: ...
def ProcessedDataAddSweepData(builder: flatbuffers.Builder, sweepData: uoffset) -> None: ...
def ProcessedDataAddWavelength(builder: flatbuffers.Builder, wavelength: uoffset) -> None: ...
def ProcessedDataStartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ProcessedDataAddPowerData(builder: flatbuffers.Builder, powerData: uoffset) -> None: ...
def ProcessedDataStartPowerDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPowerDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ProcessedDataAddPowerDataStatus(builder: flatbuffers.Builder, powerDataStatus: typing.Literal[DataStatus.NoData, DataStatus.Original, DataStatus.Processed]) -> None: ...
def ProcessedDataAddPowerMonitorData(builder: flatbuffers.Builder, powerMonitorData: uoffset) -> None: ...
def ProcessedDataStartPowerMonitorDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPowerMonitorDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ProcessedDataAddPowerMonitorDataStatus(builder: flatbuffers.Builder, powerMonitorDataStatus: typing.Literal[DataStatus.NoData, DataStatus.Original, DataStatus.Processed]) -> None: ...
def ProcessedDataAddReferenceConditions(builder: flatbuffers.Builder, referenceConditions: uoffset) -> None: ...
def ProcessedDataEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

