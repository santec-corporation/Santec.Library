from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Parameters.DeviceKey import DeviceKey
from Santec.STSProcess.Process.Native.Result.ModuleKey import ModuleKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ChannelKey(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ChannelKey: ...
  @classmethod
  def GetRootAsChannelKey(cls, buf: bytes, offset: int) -> ChannelKey: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def DeviceKey(self) -> DeviceKey | None: ...
  def ChannelNumber(self) -> int: ...
  def ModuleKey(self) -> ModuleKey | None: ...
def ChannelKeyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ChannelKeyAddDeviceKey(builder: flatbuffers.Builder, deviceKey: uoffset) -> None: ...
def ChannelKeyAddChannelNumber(builder: flatbuffers.Builder, channelNumber: int) -> None: ...
def ChannelKeyAddModuleKey(builder: flatbuffers.Builder, moduleKey: uoffset) -> None: ...
def ChannelKeyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

