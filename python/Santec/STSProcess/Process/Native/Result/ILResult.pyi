from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Rescale.RescaledScanData import RescaledScanData
from Santec.STSProcess.Process.Native.Result.ILSweepData import ILSweepData
from Santec.STSProcess.Process.Native.Result.SweepKey import SweepKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ILResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ILResult: ...
  @classmethod
  def GetRootAsILResult(cls, buf: bytes, offset: int) -> ILResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Wavelength(self, i: int) -> typing.List[float]: ...
  def WavelengthAsNumpy(self) -> np.ndarray: ...
  def WavelengthLength(self) -> int: ...
  def WavelengthIsNone(self) -> bool: ...
  def WavelengthUnit(self) -> int: ...
  def SweepKey(self) -> SweepKey | None: ...
  def InsertionLoss(self) -> ILSweepData | None: ...
  def RescaledData(self, i: int) -> RescaledScanData | None: ...
  def RescaledDataLength(self) -> int: ...
  def RescaledDataIsNone(self) -> bool: ...
def ILResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ILResultAddWavelength(builder: flatbuffers.Builder, wavelength: uoffset) -> None: ...
def ILResultStartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartWavelengthVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ILResultAddWavelengthUnit(builder: flatbuffers.Builder, wavelengthUnit: int) -> None: ...
def ILResultAddSweepKey(builder: flatbuffers.Builder, sweepKey: uoffset) -> None: ...
def ILResultAddInsertionLoss(builder: flatbuffers.Builder, insertionLoss: uoffset) -> None: ...
def ILResultAddRescaledData(builder: flatbuffers.Builder, rescaledData: uoffset) -> None: ...
def ILResultStartRescaledDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartRescaledDataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ILResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

