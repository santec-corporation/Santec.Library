  def GetRootAs(cls, buf: bytes, offset: int) -> ReferenceConditions: ...
  @classmethod
  def GetRootAsReferenceConditions(cls, buf: bytes, offset: int) -> ReferenceConditions: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def SweepSpeed(self) -> float: ...
  def Power(self) -> float: ...
  def PowerUnit(self) -> int: ...
  def Step(self) -> float: ...
  def RangeNumber(self) -> int: ...
def ReferenceConditionsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ReferenceConditionsAddSweepSpeed(builder: flatbuffers.Builder, sweepSpeed: float) -> None: ...
def ReferenceConditionsAddPower(builder: flatbuffers.Builder, power: float) -> None: ...
def ReferenceConditionsAddPowerUnit(builder: flatbuffers.Builder, powerUnit: int) -> None: ...
def ReferenceConditionsAddStep(builder: flatbuffers.Builder, step: float) -> None: ...
def ReferenceConditionsAddRangeNumber(builder: flatbuffers.Builder, rangeNumber: int) -> None: ...
def ReferenceConditionsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

