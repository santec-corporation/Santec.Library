from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SweepInfo(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SweepInfo: ...
  @classmethod
  def GetRootAsSweepInfo(cls, buf: bytes, offset: int) -> SweepInfo: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Start(self) -> float: ...
  def Stop(self) -> float: ...
  def Step(self) -> float: ...
def SweepInfoStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SweepInfoAddStart(builder: flatbuffers.Builder, start: float) -> None: ...
def SweepInfoAddStop(builder: flatbuffers.Builder, stop: float) -> None: ...
def SweepInfoAddStep(builder: flatbuffers.Builder, step: float) -> None: ...
def SweepInfoEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

