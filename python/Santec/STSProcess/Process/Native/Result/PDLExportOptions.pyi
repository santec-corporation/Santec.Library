from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PDLExportOptions(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PDLExportOptions: ...
  @classmethod
  def GetRootAsPDLExportOptions(cls, buf: bytes, offset: int) -> PDLExportOptions: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ExportRawData(self) -> bool: ...
  def ExportIlMinMax(self) -> bool: ...
  def Export4Sop(self) -> bool: ...
  def ExportMuellerData(self) -> bool: ...
def PDLExportOptionsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PDLExportOptionsAddExportRawData(builder: flatbuffers.Builder, exportRawData: bool) -> None: ...
def PDLExportOptionsAddExportIlMinMax(builder: flatbuffers.Builder, exportIlMinMax: bool) -> None: ...
def PDLExportOptionsAddExport4Sop(builder: flatbuffers.Builder, export4Sop: bool) -> None: ...
def PDLExportOptionsAddExportMuellerData(builder: flatbuffers.Builder, exportMuellerData: bool) -> None: ...
def PDLExportOptionsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

