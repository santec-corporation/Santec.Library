from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.SweepResultEntry import SweepResultEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SweepResultSet(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SweepResultSet: ...
  @classmethod
  def GetRootAsSweepResultSet(cls, buf: bytes, offset: int) -> SweepResultSet: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Results(self, i: int) -> SweepResultEntry | None: ...
  def ResultsLength(self) -> int: ...
  def ResultsIsNone(self) -> bool: ...
def SweepResultSetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SweepResultSetAddResults(builder: flatbuffers.Builder, results: uoffset) -> None: ...
def SweepResultSetStartResultsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartResultsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SweepResultSetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

