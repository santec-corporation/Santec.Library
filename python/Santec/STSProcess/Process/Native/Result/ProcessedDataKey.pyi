from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from Santec.STSProcess.Process.Native.Result.SOP import SOP
from Santec.STSProcess.Process.Native.Result.SweepKey import SweepKey

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ProcessedDataKey(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ProcessedDataKey: ...
  @classmethod
  def GetRootAsProcessedDataKey(cls, buf: bytes, offset: int) -> ProcessedDataKey: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def SweepKey(self) -> SweepKey | None: ...
  def Sop(self) -> typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]: ...
  def BandIndex(self) -> int: ...
def ProcessedDataKeyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ProcessedDataKeyAddSweepKey(builder: flatbuffers.Builder, sweepKey: uoffset) -> None: ...
def ProcessedDataKeyAddSop(builder: flatbuffers.Builder, sop: typing.Literal[SOP.None_, SOP.VLP, SOP.HLP, SOP.LP45, SOP.LPN45, SOP.RCP, SOP.LCP]) -> None: ...
def ProcessedDataKeyAddBandIndex(builder: flatbuffers.Builder, bandIndex: int) -> None: ...
def ProcessedDataKeyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

