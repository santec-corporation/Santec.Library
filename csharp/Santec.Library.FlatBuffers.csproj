<Project Sdk="Microsoft.NET.Sdk">

	<!--
		tools/generate_csharp_bindings.py generates the classes under Santec/ from
		the private submodule's schemas and vendors them here, so this folder builds
		without the submodule. They target netstandard2.0: that is what .NET
		Framework 4.6.1 and later, VB.NET and every modern .NET can consume, and
		reading a payload needs nothing a newer target adds.

		The runtime comes from the Google.FlatBuffers package rather than a vendored
		copy: the generated classes call FlatBufferConstants.FLATBUFFERS_<flatc
		version>(), and the package declares only the version it was built with, so
		the two versions have to match. The generator's check mode enforces that,
		rather than letting a flatc or package bump land alone and fail in a
		consumer's build.
	-->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyName>Santec.Library.FlatBuffers</AssemblyName>
		<!-- The generated tree carries no XML documentation and no nullable annotations. -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.FlatBuffers" Version="25.12.19" />
	</ItemGroup>

</Project>
