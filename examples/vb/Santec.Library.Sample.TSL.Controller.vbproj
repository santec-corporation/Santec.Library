<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!--
			net10.0 is the current target; on Windows the project also builds net48,
			where Marshal.PtrToStringUTF8 does not exist and the loader does not
			append ".dll" to a name that already contains a dot. The native library is
			x64 only, so both targets build as x64. A machine without the .NET
			Framework targeting pack cannot restore the net48 leg, which is why it is
			Windows-only.
		-->
		<TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
		<TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
		<PlatformTarget>x64</PlatformTarget>
		<OptionStrict>On</OptionStrict>
		<OptionExplicit>On</OptionExplicit>
		<OptionInfer>On</OptionInfer>
		<AssemblyName>Santec.Library.Sample.TSL.Controller</AssemblyName>
		<RootNamespace>Santec.Library.Sample.TSL.Controller.Vb</RootNamespace>
	</PropertyGroup>

	<!--
		There is no managed package to reference: the example declares the entry
		points it calls (Native.vb) and loads the committed native library. The DLL
		is copied next to the executable, which is where the runtime looks for it.
	-->
	<ItemGroup>
		<None Include="..\..\lib\win-x64\Santec.Library.dll"
		      Link="Santec.Library.dll"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
