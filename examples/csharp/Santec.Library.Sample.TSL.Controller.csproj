<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>Santec.Library.Sample.TSL.Controller</AssemblyName>
		<RootNamespace>Santec.Library.Sample.TSL.Controller</RootNamespace>
	</PropertyGroup>

	<!--
		There is no managed package to reference: the example declares the entry
		points it calls (Native.cs) and loads the committed native library. The DLL
		is copied next to the executable, which is where the runtime looks for it.
	-->
	<ItemGroup>
		<None Include="..\..\lib\win-x64\Santec.Library.dll"
		      Link="Santec.Library.dll"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
